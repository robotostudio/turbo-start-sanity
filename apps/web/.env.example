NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Presentation e2e only. Editor-role token; falls back to SANITY_API_WRITE_TOKEN.
SANITY_E2E_SESSION_TOKEN=
# Dataset the Presentation suite runs against. Defaults to `e2e`; it publishes
# into the real navbar/footer/settings, so never point it at production.
SANITY_E2E_DATASET=
# Set when apps/studio/functions are deployed; skips the redirect test if not.
SANITY_E2E_FUNCTIONS_DEPLOYED=
