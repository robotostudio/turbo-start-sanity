{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "MIT",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "deploy-graphql": "sanity graphql deploy",
    "extract": "sanity schema extract --force",
    "check-types": "tsc --noEmit",
    "type": "sanity typegen generate && biome format --write ../../packages/sanity/src/sanity.types.ts",
    "sync-thumbnails": "node --experimental-strip-types ../../packages/sanity-blocks/scripts/sync-thumbnails.ts --target-root ../../apps/studio/static/thumbnails --file-prefix preview-",
    "postinstall": "sanity exec scripts/cli-alert-for-data.ts && pnpm sync-thumbnails"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@robotostudio/sanity-plugin-lucide-icon-picker": "^1.0.0",
    "@sanity/assist": "^6.1.21",
    "@sanity/client": "catalog:",
    "@sanity/functions": "^1.6.9",
    "@sanity/icons": "^3.8.0",
    "@sanity/orderable-document-list": "^2.0.22",
    "@sanity/ui": "^3.5.3",
    "@sanity/vision": "^6.11.0",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/sanity-blocks": "workspace:*",
    "dotenv": "^17.4.2",
    "friendlier-words": "^1.2.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-is": "catalog:",
    "sanity": "catalog:",
    "sanity-plugin-asset-source-unsplash": "^7.0.25",
    "sanity-plugin-media": "^6.1.6",
    "sanity-plugin-mux-input": "^5.0.12",
    "slugify": "^1.6.9",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/blueprints": "^0.24.0",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.2.2"
  }
}
