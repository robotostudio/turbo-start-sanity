{
  "name": "@workspace/sanity-blocks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "sync-thumbnails": "node --experimental-strip-types scripts/sync-thumbnails.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sanity": "catalog:"
  },
  "dependencies": {
    "@portabletext/markdown": "^1.4.2",
    "@sanity/client": "catalog:",
    "@sanity/icons": "^3.7.4",
    "@workspace/env": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/tailwind-config": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "catalog:",
    "next-sanity": "13.1.0",
    "next-themes": "catalog:",
    "sanity": "catalog:",
    "sanity-image": "^1.1.0",
    "schema-dts": "^1.1.5",
    "slugify": "^1.6.8"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.4",
    "@workspace/typescript-config": "workspace:*",
    "next": "16.2.9",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/sanity-blocks.ts",
    "./*/index": "./src/*/index.tsx",
    "./*/json-ld": "./src/*/json-ld.ts",
    "./*.schema": "./src/*.schema.ts",
    "./*.groq": "./src/*.groq.ts",
    "./internal/block-eyebrow": "./src/internal/block-eyebrow.tsx",
    "./internal/block-header": "./src/internal/block-header.tsx",
    "./internal/blog-categories": "./src/internal/blog-categories.ts",
    "./internal/heading-slug": "./src/internal/heading-slug.ts",
    "./internal/icons": "./src/internal/icons.tsx",
    "./internal/logo-height": "./src/internal/logo-height.ts",
    "./internal/lucide-icon-preview": "./src/internal/lucide-icon-preview.tsx",
    "./internal/page-builder-to-markdown": "./src/internal/page-builder-to-markdown.ts",
    "./internal/portable-text-to-markdown": "./src/internal/portable-text-to-markdown.ts",
    "./internal/rendering": "./src/internal/rendering.tsx",
    "./internal/safe-href": "./src/internal/safe-href.ts",
    "./internal/rich-text": "./src/internal/rich-text.tsx",
    "./internal/sanity-buttons": "./src/internal/sanity-buttons.tsx",
    "./internal/sanity-image": "./src/internal/sanity-image.tsx",
    "./internal/sanity-icon": "./src/internal/sanity-icon.tsx",
    "./internal/sanity-rich-text": "./src/internal/sanity-rich-text.ts",
    "./internal/schema-fields": "./src/internal/schema-fields.ts",
    "./internal/use-copy": "./src/internal/use-copy.ts",
    "./internal/use-disclosure-animation": "./src/internal/use-disclosure-animation.ts"
  }
}
